 367          void Timer1_Init(void)          //50毫秒@12.000MHz
 368          {
 369   1              // 同时设置定时器0和1时，注意这两个寄存器需要正确设置！！
 370   1              // !!! 使用 TMOD = 0x00; 好像有问题，使用 TMOD &= 0x00; 才能正常工作！！！
 371   1              AUXR &= 0x3F;                   //设置定时器0和1, 时钟12T模式
 372   1              TMOD &= 0x00;                   //设置定时器0和1, 模式为16位自动重载模式
 373   1              
 374   1              // AUXR &= 0xBF;                        //定时器时钟12T模式
 375   1              // TMOD &= 0x0F;                        //设置定时器模式
 376   1              TL1 = 0xB0;                             //设置定时初始值
 377   1              TH1 = 0x3C;                             //设置定时初始值
 378   1              TF1 = 0;                                //清除TF1标志
 379   1              TR1 = 1;                                //定时器1开始计时
 380   1              ET1 = 1;                                //使能定时器1中断
 381   1      }
