 439          // 定时器0的中断处理, 每10微秒一次
 440          void Timer0_Isr(void) interrupt 1
 441          {       
 442   1              IR_RX_Time_Interval_10us++; // 微秒计时
 443   1              
 444   1              
 445   1              // 正在接收数据
 446   1              if(IR_RX_State == IR_RX_STATE_RECEIVING){ 
 447   2                      
 448   2                      IR_RX_us_Duration ++;  // 10微秒中断一次
 449   2                      if(IR_RX_us_Duration > 11000){
 450   3                              IR_RX_us_Duration = 0;
 451   3                              
 452   3                              IR_RX_State = IR_RX_STATE_NONE;
 453   3                              IR_RX_Time_Interval_10us = 0;
 454   3                              rawDataIndex = 0;
 455   3                      }
 456   2                      
 457   2              }
 458   1      }
