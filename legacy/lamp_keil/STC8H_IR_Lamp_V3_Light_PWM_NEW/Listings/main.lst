 427          void Timer0_Init(void)          //10微秒@12.000MHz
 428          {
 429   1              AUXR &= 0x7F;                   //定时器时钟12T模式
 430   1              TMOD &= 0xF0;                   //设置定时器模式
 431   1              TL0 = 0xF6;                             //设置定时初始值
 432   1              TH0 = 0xFF;                             //设置定时初始值
 433   1              TF0 = 0;                                //清除TF0标志
 434   1              TR0 = 1;                                //定时器0开始计时
 435   1              ET0 = 1;                                //使能定时器0中断
 436   1      }
